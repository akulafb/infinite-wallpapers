# Copy to keystore.properties (git-ignored) and fill in. Keep the .jks file
# and passwords backed up outside this repo — Play needs the same upload key
# for every update (or a key reset through Play Console support).
storeFile=/absolute/path/to/upload-key.jks
storePassword=
keyAlias=upload
keyPassword=

# Google Play upload API (optional). Path to the service account JSON key
# used by ./gradlew publishBundle. Keep it outside the repo.
playServiceAccount=/absolute/path/to/play-service-account.json
