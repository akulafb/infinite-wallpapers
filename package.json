{
  "name": "infinite-wallpapers",
  "version": "1.0.0",
  "productName": "Infinite Wallpapers",
  "description": "Constantly changing wallpapers by theme",
  "author": "akulafb",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "type-check": "tsc --noEmit",
    "dist": "npm run build && electron-builder --mac"
  },
  "//": "Everything is bundled into dist/ at build time, so the packaged app ships no node_modules.",
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.4",
    "lucide-react": "^0.542.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.3",
    "vite": "^8.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.akulafb.infinite-wallpapers",
    "productName": "Infinite Wallpapers",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Infinite Wallpapers uses System Events to change your desktop wallpaper."
      }
    }
  }
}
