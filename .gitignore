# OS files
.DS_Store

# Dependencies (inside sources/)
sources/node_modules/

# Build output — regenerate with `npm run verify` from sources/.
# Not versioned: every build emits new content-hashed asset filenames, so
# tracking it churns the repo on each verify. runtime/app-icon.icns and
# runtime/package.json stay tracked: the icon is a binary that sources/
# deliberately ignores, so this is its only copy.
runtime/build/
